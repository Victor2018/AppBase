<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mClMonthCell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/dp_8"
    android:layout_marginStart="@dimen/dp_8"
    android:layout_marginEnd="@dimen/dp_8"
    android:background="@drawable/ripple_fff3f4_radius_8"
    tools:ignore="ResourceName">

    <TextView
        android:id="@+id/mTvMonth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/mTvMonthValue"
        app:layout_constraintVertical_chainStyle="packed"
        android:gravity="center"
        android:textSize="@dimen/dp_24"
        android:textColor="@color/color_1A1A1A"
        tools:text="1"/>

    <TextView
        android:id="@+id/mTvMonthValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/mTvMonth"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/dp_4"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="@dimen/dp_20"
        android:textColor="@color/color_FF3141"
        tools:text="+30.60"/>

</androidx.constraintlayout.widget.ConstraintLayout>




